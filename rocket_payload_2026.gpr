with "config/rocket_payload_2026_config.gpr";
project Rocket_Payload_2026 is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Rocket_Payload_2026_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("rocket_payload_2026.adb");

   package Compiler is
      for Default_Switches ("Ada") use Rocket_Payload_2026_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Rocket_Payload_2026;
